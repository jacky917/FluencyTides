# ====================================================================
# FluencyTides 環境變數配置範例
# 
# 複製此檔案為 `.env` 並填寫對應的敏感資訊。
# 所有的環境變數均由 `backend/app/core/config.py` 中的 Settings 管理。
# ====================================================================

# Telegram 動態修改設定 (可選)
# 只要以 MODIFY_ 開頭，即代表允許透過 Telegram /setconfig 動態修改該變數。
# 留空代表無限制，若設定為陣列字串則代表限制在該清單內。
# 注意：僅 TG_ADMIN_CHAT_ID 所設定的管理員有權限呼叫此功能。
# ====================================================================
MODIFY_AUDIO_MODEL_NAME=['gemini-1.5-pro', 'gemini-1.5-flash', 'gemini-2.0-flash', 'gemini-2.0-pro-exp-02-05']
MODIFY_AUDIO_EVALUATOR_PROVIDER=['gemini_native', 'openai', 'stt_diff', 'stt_llm']
MODIFY_STT_LLM_MODEL_NAME=['gemini-2.5-flash', 'gemini-2.0-flash']

# --------------------------------------------------------------------
# 應用程式基礎設定
# --------------------------------------------------------------------
# 專案名稱 (可選)
PROJECT_NAME=FluencyTides
# 系統日誌層級 (可選，DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO
# 日誌檔案儲存路徑 (可選，預設在 backend/logs/fluencytides.log)
LOG_FILE_PATH=logs/fluencytides.log
# API 認證金鑰 (可選，留空或不設代表開發模式跳過認證)
API_SECRET_KEY=your_api_secret_key_here

# --------------------------------------------------------------------
# 資料庫設定 (SQLModel + SQLAlchemy Async)
# --------------------------------------------------------------------
# 主要的資料庫連線字串 (應用程式本體資料庫)
# 用途: 儲存系統狀態、使用者偏好、機器人暫存狀態等輕量級資料。
# 預設使用 SQLite，適合開發與單人使用，確保不會被龐大的檢索吃掉資源。
DATABASE_URL=sqlite+aiosqlite:///./fluencytides.db

# 語料庫與 NLP 檢索用 MySQL 設定 (生產環境最佳實踐)
# 用途: 儲存 20MB+ 以上的遊戲文本與日文句庫。
# 獨立運作以確保進階 NLP 檢索與正規表達式查詢的高效能，不拖慢主程式。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=fluencytides_corpus

# --------------------------------------------------------------------
# Elasticsearch 設定 (NLP 檢索與語料庫)
# --------------------------------------------------------------------
# Docker 容器內部的連線位址 (速度最快、最安全)
ELASTICSEARCH_HOSTS=http://elasticsearch:9200
# 提供給 Windows 本機測試腳本使用的外部公開位址
ELASTICSEARCH_PUBLIC_URL=https://es.jacky917.com
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elastic_password

# --------------------------------------------------------------------
# JP_VerbPair 卡片專屬：語料庫上下文擷取設定
# --------------------------------------------------------------------
# 決定目標句的前後要抓取多少句腳本作為 LLM 的參考文脈
JP_VERB_PAIR_CONTEXT_PREV=20
JP_VERB_PAIR_CONTEXT_NEXT=10

# 單一動詞（自動詞與他動詞獨立計算）最多生成的子卡片數量
JP_VERB_PAIR_MAX_CARDS_PER_VERB=20
# 音檔目錄絕對路徑
JP_VERB_PAIR_VOICE_DIR=C:\path\to\your\voice\dir
# 頭像目錄絕對路徑
JP_VERB_PAIR_AVATAR_DIR=C:\path\to\your\avatar\dir
# 遊戲來源前綴（用於產生 Anki 音檔標籤與尋找媒體）
JP_VERB_PAIR_SOURCE_GAME=YourSourceGamePrefix
# 遊戲日文原名，用於 LLM 提示詞與卡片標籤
JP_VERB_PAIR_GAME_NAME_JP=あなたのゲーム名

# --------------------------------------------------------------------
# JP_CoreVerb 卡片專屬：語料庫上下文擷取設定
# --------------------------------------------------------------------
# 決定目標句的前後要抓取多少句腳本作為 LLM 的參考文脈
JP_CORE_VERB_CONTEXT_PREV=20
JP_CORE_VERB_CONTEXT_NEXT=10
# 單一核心動詞最多生成的子卡片數量（verb_search_config.json 可 per-verb 覆寫）
JP_CORE_VERB_MAX_CARDS_PER_VERB=15
# 同一章節最多取句數（避免語料集中於單一劇情段落）
JP_CORE_VERB_MAX_PER_CHAPTER=2
# 目標句最短長度（字元數）
JP_CORE_VERB_MIN_SENTENCE_LENGTH=8
# 音檔目錄絕對路徑
JP_CORE_VERB_VOICE_DIR=C:\path\to\your\voice\dir
# 頭像目錄絕對路徑
JP_CORE_VERB_AVATAR_DIR=C:\path\to\your\avatar\dir
# 遊戲來源前綴（用於產生 Anki 音檔標籤與尋找媒體）
JP_CORE_VERB_SOURCE_GAME=YourSourceGamePrefix
# 遊戲日文原名，用於 LLM 提示詞與卡片標籤
JP_CORE_VERB_GAME_NAME_JP=あなたのゲーム名
# 核心動詞母卡片所在的 Anki 牌組名稱
JP_CORE_VERB_MASTER_DECK=日本語::核心動詞::Master

# --------------------------------------------------------------------
# Speaking_Trilingual_Dark 卡片匯入設定
# --------------------------------------------------------------------
# 三語口說卡的根牌組名稱。所有由 jsons/ 匯入的卡片都掛在此牌組之下，
# 其後的階層由 JSON 的 deckName 與檔案相對路徑決定。改這一處即可整批搬家
SPEAKING_TRILINGUAL_ROOT_DECK=日常會話

# --------------------------------------------------------------------
# AnkiConnect 設定
# --------------------------------------------------------------------
# AnkiConnect 本地或遠端端點 URL (可選)
ANKI_CONNECT_URL=http://127.0.0.1:8765
# AnkiConnect API 金鑰 (可選)
ANKI_CONNECT_API_KEY=your_ankiconnect_api_key_here

# --------------------------------------------------------------------
# Cloudflare Access 設定 (用於遠端 AnkiConnect 穿透，可選)
# --------------------------------------------------------------------
# Cloudflare Access Client ID (可選)
CF_ACCESS_CLIENT_ID=your_cloudflare_client_id.access
# Cloudflare Access Client Secret (可選)
CF_ACCESS_CLIENT_SECRET=your_cloudflare_client_secret

# --------------------------------------------------------------------
# MinIO 物件存儲設定
# --------------------------------------------------------------------
# MinIO 伺服器主機位址 (可選)
MINIO_HOST=127.0.0.1
# MinIO 伺服器埠號 (可選)
MINIO_PORT=9000
# MinIO 存取金鑰 (可選)
MINIO_ACCESS_KEY=minioadmin
# MinIO 秘密金鑰 (可選)
MINIO_SECRET_KEY=minioadmin
# 是否使用 HTTPS 連線 MinIO (可選)
MINIO_SECURE=False
# MinIO 預設儲存桶名稱 (可選)
MINIO_DEFAULT_BUCKET=fluencytides-media

# --------------------------------------------------------------------
# Telegram Bot 設定 (Phase 3)
# --------------------------------------------------------------------
# Telegram Bot Token (可選，向 @BotFather 取得)
TG_BOT_TOKEN=123456789:ABCDefghIJKLmnopQRSTuvwxYZ
# Telegram Bot 使用者名稱 (可選，例如: XXX_bot，用於生成 Deep Link)
TG_BOT_USERNAME=XXX_bot
# 管理員的 Telegram Chat ID，用於接收未預期崩潰通知 (可選)
TG_ADMIN_CHAT_ID=123456789
# 允許使用的 User ID 列表 (可選，逗號分隔，避免他人盜刷 LLM 額度)
TG_ALLOWED_USER_IDS=123456789,987654321
# 生產環境 Webhook 網域名稱 (可選，若留空則預設使用 Long Polling)
TG_WEBHOOK_DOMAIN=https://your-domain.com
# Webhook 接收路徑 (可選)
TG_WEBHOOK_PATH=/api/webhook
# Webhook 驗證金鑰 (可選，設定後會要求 Telegram 帶上此密碼以增強安全性)
TG_WEBHOOK_SECRET=your_super_secret_token_here
# Telegram 兩階段互動狀態過期時間 (分鐘)
TG_STATE_EXPIRE_MINUTES=10

# 自訂的筆記來源標籤 (逗號分隔)
NOTE_SOURCE_TAGS="仕事,GRAVITY,HelloTalk"

# --------------------------------------------------------------------
# LLM (OpenAI 相容) 設定
# --------------------------------------------------------------------
# OpenAI / Gemini 相容 API 金鑰 (可選)
LLM_API_KEY=your_llm_api_key_here
# OpenAI / Gemini 相容 API 端點 URL (可選)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM 預設模型名稱 (可選)
LLM_MODEL_NAME=gemini-2.0-flash

# 語音評分器的供應商選擇: 'gemini_native' (預設), 'openai' (相容 API), 'proxy' (第三方中轉),
# 'stt_diff' (本地 Whisper + difflib 零成本比對), 'stt_llm' (本地 Whisper + 純文字 LLM)
AUDIO_EVALUATOR_PROVIDER=gemini_native

# --------------------------------------------------------------------
# STT (自架 Whisper / Speaches) 設定
# --------------------------------------------------------------------
# Speaches 服務的 OpenAI 相容端點 (含 /v1)
STT_SERVER_URL=http://192.168.50.171:8000/v1
# faster-whisper 模型 ID (需先於伺服器手動安裝: POST /v1/models/<model_id>)
STT_MODEL_NAME=Systran/faster-whisper-large-v3
# 自架服務可任意填寫，但 OpenAI SDK 要求非空
STT_API_KEY=speaches
# stt_llm 模式專用的純文字評分模型 (與多模態 AUDIO_MODEL_NAME 脫鉤)
STT_LLM_MODEL_NAME=gemini-2.5-flash
# 語音模型 API 獨立設定 (例如專門處理語音轉文字與評分的模型)
# AUDIO_API_KEY=your_audio_api_key_here
# AUDIO_BASE_URL=https://api.openai.com/v1  # (僅在使用 openai 或 proxy 供應商時需要填寫)
# AUDIO_MODEL_NAME=gemini-2.5-flash

# --------------------------------------------------------------------
# VOICEPEAK 語音合成設定
# --------------------------------------------------------------------
# VOICEPEAK CLI 執行檔的完整路徑或命令名稱 (可選)
VOICEPEAK_EXECUTABLE_PATH=voicepeak
# VOICEPEAK 預設旁白角色名稱 (CLI 英文 ID) (可選)
VOICEPEAK_DEFAULT_NARRATOR=Japanese Male Child
# 角色設定 JSON 檔案路徑 (可選)
VOICEPEAK_CHARACTERS_CONFIG_PATH=characters.json

# --------------------------------------------------------------------
# Scripts 內部與遠端測試腳本設定
# --------------------------------------------------------------------
# 腳本呼叫 API 的基礎 URL (若透過 Cloudflare Tunnel 遠端測試，請填寫完整網域)
SCRIPTS_API_BASE_URL=http://127.0.0.1:8000
