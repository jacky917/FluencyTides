# ====================================================================
# FluencyTides 環境變數配置範例
#
# 所有變數均由 backend/app/core/config.py 的 Settings 管理（75 個欄位全數列出，
# 未啟用者以註解保留並標示預設值）。複製本檔為 .env 並填入真實密鑰；.env 已被 .gitignore 排除。
#
# 目錄：
#   1. Telegram 動態修改白名單 (MODIFY_*)     8. MinIO 物件存儲
#   2. 應用程式基礎                            9. Telegram Bot
#   3. 資料庫 (SQLite / MySQL)               10. LLM（文字生成）與 Provider 選擇
#   4. Elasticsearch                         11. claude-code Provider 專屬
#   5. JP_VerbPair 卡片管線                   12. 語音評分 (Audio)
#   6. JP_CoreVerb 卡片管線                   13. STT (自架 Whisper)
#   7. Anki 牌組 / AnkiConnect / Cloudflare  14. VOICEPEAK / Scripts
# ====================================================================


# ====================================================================
# 1. Telegram 動態修改白名單 (MODIFY_*)
# --------------------------------------------------------------------
# 以 MODIFY_ 開頭即代表允許管理員透過 Telegram /setconfig 臨時修改該變數
# （只存在記憶體，重啟後回到本檔的值）。
# 值留空 = 無限制輸入；值為陣列字串 = 限制在清單內用按鈕選擇。
# 僅 TG_ADMIN_CHAT_ID 設定的管理員有權限使用。
# ====================================================================
MODIFY_AUDIO_MODEL_NAME=['gemini-3.1-flash-lite', 'gemini-3.5-flash', 'gemini-3.1-pro-preview']
MODIFY_LLM_MODEL_NAME=['gemini-3.1-flash-lite', 'gemini-3.5-flash', 'gemini-3.1-pro-preview']
MODIFY_AUDIO_EVALUATOR_PROVIDER=['gemini_native', 'openai', 'stt_diff', 'stt_llm']
MODIFY_STT_LLM_MODEL_NAME=['gemini-3.1-flash-lite', 'gemini-3.5-flash', 'gemini-3.1-pro-preview']
# 【未啟用】claude-code provider 的 TG 切換（啟用前請先理解 provider 與
#           model 的耦合：兩者要一起換，切一半下一次生成會報錯）
# MODIFY_LLM_PROVIDER=['google', 'claude-code']
# MODIFY_LLM_CLAUDE_CODE_EFFORT=['low', 'medium', 'high', 'xhigh', 'max']


# ====================================================================
# 2. 應用程式基礎
# ====================================================================
# 專案名稱
PROJECT_NAME=FluencyTides

# 系統日誌層級。可選值：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# 日誌檔案儲存路徑（相對 backend/）
LOG_FILE_PATH=logs/fluencytides.log

# API 認證金鑰。留空或不設 = 開發模式，跳過認證
API_SECRET_KEY=


# ====================================================================
# 3. 資料庫
# ====================================================================
# 主資料庫連線字串（系統狀態、使用者偏好、機器人暫存等輕量資料）。
# 預設 SQLite（零配置、適合單人）；多人併發可改用下方註解的 MySQL 形式
DATABASE_URL=sqlite+aiosqlite:///./fluencytides.db
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/fluencytides

# 語料庫專用 MySQL（20MB+ 遊戲文本與日文句庫，與主資料庫分離以確保
# NLP 檢索與正規表達式查詢的效能）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=fluencytides_corpus


# ====================================================================
# 4. Elasticsearch（NLP 檢索與語料庫）
# ====================================================================
# 主要連線位址（Docker 內部或區網，速度最快）
ELASTICSEARCH_HOSTS=http://localhost:9200
# 外部公開位址（本機測試腳本優先使用；可選）
# ELASTICSEARCH_PUBLIC_URL=https://es.example.com
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_es_password


# ====================================================================
# 5. JP_VerbPair 卡片管線（自他動詞對）
# ====================================================================
# 目標句前後各抓取幾句腳本作為 LLM 參考文脈
JP_VERB_PAIR_CONTEXT_PREV=20
JP_VERB_PAIR_CONTEXT_NEXT=10

# 單一動詞（自動詞與他動詞獨立計算）最多生成的子卡片數量
JP_VERB_PAIR_MAX_CARDS_PER_VERB=20

# 音檔 / 頭像目錄絕對路徑
JP_VERB_PAIR_VOICE_DIR=C:\path\to\material\voice\YourGame
JP_VERB_PAIR_AVATAR_DIR=C:\path\to\material\avatar\YourGame

# 遊戲來源前綴（Anki 音檔標籤與媒體檔名）與日文原名（對應 LLM 世界觀模板
# app/templates/prompts/worldviews/<此值>.j2，並用於卡片標籤）
JP_VERB_PAIR_SOURCE_GAME=SabbatOfTheWitch
JP_VERB_PAIR_GAME_NAME_JP=サノバウィッチ

# 選句時過濾「純呻吟句」（擬態音節密度過高的 R18 台詞，動詞用法正確但
# 教學價值低）。預設 true；設 false 可保留這類句子
JP_VERB_PAIR_FILTER_MOAN_SENTENCES=true


# ====================================================================
# 6. JP_CoreVerb 卡片管線（核心動詞）
# ====================================================================
# 目標句前後各抓取幾句腳本作為 LLM 參考文脈
JP_CORE_VERB_CONTEXT_PREV=20
JP_CORE_VERB_CONTEXT_NEXT=10

# 單一核心動詞最多生成的子卡片數量（verb_search_config.json 可 per-verb 覆寫）
JP_CORE_VERB_MAX_CARDS_PER_VERB=20

# 同一章節最多取句數（避免語料集中於單一劇情段落）
JP_CORE_VERB_MAX_PER_CHAPTER=2

# 目標句最短長度（字元數），過短的句子缺乏文脈價值
JP_CORE_VERB_MIN_SENTENCE_LENGTH=8

# 音檔 / 頭像目錄絕對路徑
JP_CORE_VERB_VOICE_DIR=C:\path\to\material\voice\YourGame
JP_CORE_VERB_AVATAR_DIR=C:\path\to\material\avatar\YourGame

# 遊戲來源前綴與日文原名（用途同 JP_VerbPair）
JP_CORE_VERB_SOURCE_GAME=SabbatOfTheWitch
JP_CORE_VERB_GAME_NAME_JP=サノバウィッチ

# 核心動詞母卡片所在的 Anki 牌組名稱
JP_CORE_VERB_MASTER_DECK=日本語::核心動詞::Master


# ====================================================================
# 7. Anki 牌組 / AnkiConnect / Cloudflare Access
# ====================================================================
# 三語口說卡（Speaking_Trilingual_Dark）的根牌組。jsons/ 匯入的卡片全掛此
# 牌組下，其後階層由 JSON 的 deckName 與檔案相對路徑決定；改此值即整批搬家
# SPEAKING_TRILINGUAL_ROOT_DECK=日常會話

# 單語口說卡（Speaking_Coach_Dark）的根牌組。與三語卡獨立，可分別搬家
# SPEAKING_COACH_ROOT_DECK=封存::日本語::AI點評

# Anki 模型 JSON 定義檔的相對路徑（相對 backend/）
ANKI_MODELS_DIR=app/anki_models

# AnkiConnect 端點 URL（本機預設 http://127.0.0.1:8765）
ANKI_CONNECT_URL=http://127.0.0.1:8765
# ANKI_CONNECT_URL=https://anki.example.com
# AnkiConnect API 金鑰（可選，插件端有設才需要）
ANKI_CONNECT_API_KEY=

# Cloudflare Access（遠端 AnkiConnect 穿透用；可選，兩者都設才會帶 header）
# CF_ACCESS_CLIENT_ID=your_cf_client_id.access
# CF_ACCESS_CLIENT_SECRET=your_cf_client_secret


# ====================================================================
# 8. MinIO 物件存儲
# ====================================================================
MINIO_HOST=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# 是否使用 HTTPS 連線。可選值：True / False
MINIO_SECURE=False
MINIO_DEFAULT_BUCKET=fluencytides-media


# ====================================================================
# 9. Telegram Bot
# ====================================================================
# Bot Token（向 @BotFather 取得）
# TG_BOT_TOKEN=123456789:your_bot_token_here
# Bot 使用者名稱（不含 @，用於生成 Deep Link）
# TG_BOT_USERNAME=Your_bot
# 管理員 Chat ID（接收崩潰通知 + /setconfig 權限）
# TG_ADMIN_CHAT_ID=123456789
# 允許使用的 User ID 白名單（逗號分隔，防他人盜刷 LLM 額度）
# TG_ALLOWED_USER_IDS=123456789,987654321
# Webhook 網域（留空 = 使用 Long Polling，本機開發建議留空）
# TG_WEBHOOK_DOMAIN=https://your-domain.com
# Webhook 接收路徑
TG_WEBHOOK_PATH=/api/webhook
# Webhook 驗證密鑰（設定後要求 Telegram 帶上以增強安全性；可選）
# TG_WEBHOOK_SECRET=your_webhook_secret
# 兩階段互動狀態過期時間（分鐘）
TG_STATE_EXPIRE_MINUTES=10

# 建卡時可選的筆記來源標籤（逗號分隔）
# NOTE_SOURCE_TAGS="tag1,tag2,tag3"

# TG 建卡預設值（目前未被 Settings 讀取，保留自舊版設定）
# TG_DEFAULT_DECK=Default
# TG_DEFAULT_MODEL_NAME=Speaking_Coach_Dark
# TG_DEFAULT_MODEL_FILE=Speaking_Coach_Dark.json
# TG_DEFAULT_PRIMARY_FIELD=Prompt


# ====================================================================
# 10. LLM（文字生成）與 Provider 選擇
# ====================================================================
# OpenAI 相容 API 金鑰與端點（LLM_PROVIDER 非 claude-code 時使用；
# claude-code 模式下兩者可留空）
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# ── OpenAI 相容中轉範例（搭配 LLM_PROVIDER=<中轉名>）──
# LLM_API_KEY=sk-your_relay_key
# LLM_BASE_URL=https://relay.example.com/v1
# LLM 模型名稱。
#   google 直連常用：gemini-3.1-pro-preview / gemini-3.5-flash / gemini-3.1-flash-lite
#   claude-code 模式的可用模型見第 11 區
LLM_MODEL_NAME=gemini-3.1-pro-preview
# LLM_MODEL_NAME=opus
# LLM 批次解析劇本時一次抓取的台詞數量
LLM_PARSE_BATCH_SIZE=20

# --------------------------------------------------------------------
# LLM Provider 選擇（決定上面那組 LLM_* 走哪條管道）
# --------------------------------------------------------------------
# 可用值：
#   google / openai / 留空 -> OpenAI 相容計費 API（預設，使用上方的
#                             LLM_API_KEY + LLM_BASE_URL + LLM_MODEL_NAME）
#   其他任意字串（如 yinli）-> 同上，但會在卡片標籤冠上 (provider) 前綴
#   claude-code            -> 本機 Claude Code CLI (headless)，走 Claude 訂閱額度，
#                             不計 API 費用。需先在終端執行 `claude auth login`
#                             （用 `claude auth status` 確認，已登入會回 exit 0）
#   anthropic              -> Anthropic 官方 API。【尚未實作，僅為佔位】
#                             設成此值會在啟動時直接報錯，請勿使用
LLM_PROVIDER=google


# ====================================================================
# 11. claude-code Provider 專屬設定
# --------------------------------------------------------------------
# 僅在 LLM_PROVIDER=claude-code 時讀取；其他 provider 完全忽略這些值。
# 全部都有預設值，整段不填也能運作。
# --------------------------------------------------------------------
# 【模型】切到 claude-code 時，第 10 區的 LLM_MODEL_NAME 要改成 Claude 的模型名。
#         以下清單為 2026-08-27 對本機 CLI (2.1.247) + 本帳號訂閱的實測結果。
#
#   ── 別名（推薦；永遠指向該階層的最新模型）──────────────────────────
#     opus    -> claude-opus-5             實測 18KB 提示詞約 21 秒/張，品質最佳（建議預設）
#     sonnet  -> claude-sonnet-5           實測約 36 秒/張
#     haiku   -> claude-haiku-4-5-20251001 實測約 116 秒/張（長提示詞下明顯偏慢，不建議）
#     fable   -> claude-fable-5            最高階模型（本專案未測耗時）
#
#   ── 完整模型名（釘住版本，避免別名隨 CLI 更新而漂移）─────────────────
#     claude-fable-5
#     claude-opus-5      claude-opus-4-8      claude-opus-4-7      claude-opus-4-6
#     claude-sonnet-5    claude-sonnet-4-6
#     claude-haiku-4-5   claude-haiku-4-5-20251001
#
#   ── 不可用 ──────────────────────────────────────────────────────
#     claude-mythos-5 -> 僅限 Anthropic 核准的組織，本帳號無存取權
#
#   兩類錯誤的表現不同，都會在啟動或生成時明確報錯、不會靜默降級：
#     模型名不存在（打錯字）-> CLI 回 unrecognized_model
#     模型存在但無權限      -> CLI 回「may not have access to it」
# ====================================================================
# claude 執行檔的絕對路徑。
# 留空 = 自動探測，順序為：~/.local/bin/claude.exe -> PATH -> 桌面版內建路徑
LLM_CLAUDE_CODE_CLI_PATH=

# 推理力度。可選值：low / medium / high / xhigh / max
# 預設 high（與 CLI 隱式預設行為一致；明寫是為了不受 CLI 版本更改預設值影響）
# 【警告】實測 sonnet + low 會讓挖空腦補出原文不存在的助詞，品質下降。
#         頂級模型 + low 未評估，調低前請先用實際卡片驗證品質。
# 【注意】CLI 對非法值會「靜默回退」到預設力度而不報錯，因此本專案改由
#         Python 端白名單驗證：填錯字會在啟動時直接拋錯，不會無聲跑錯力度。
LLM_CLAUDE_CODE_EFFORT=high

# CLI 執行時的專用空工作目錄（避免載入到專案的 CLAUDE.md 等脈絡）。
# 留空 = backend/.claude_code_workdir（已加入 .gitignore，會自動建立）
LLM_CLAUDE_CODE_WORKDIR=

# 單次呼叫的超時秒數。
# CLI 內建的結構化輸出重試（最多 5 次）最壞情況約 190 秒，故建議至少 300。
LLM_CLAUDE_CODE_TIMEOUT_SECONDS=900

# 每次呼叫的 prompt / answer / meta 落盤目錄，便於事後查卡片品質問題。
# 留空 = 關閉審計。預設目錄已加入 .gitignore。
LLM_CLAUDE_CODE_AUDIT_DIR=logs/claude_code_audit


# ====================================================================
# 12. 語音評分 (Audio)
# ====================================================================
# 供應商選擇。可選值：
#   gemini_native -> Google 原生 SDK（預設）
#   openai        -> OpenAI 相容 API（需 AUDIO_BASE_URL）
#   proxy         -> 第三方中轉（需 AUDIO_BASE_URL）
#   stt_diff      -> 本地 Whisper + difflib 零成本比對
#   stt_llm       -> 本地 Whisper + 純文字 LLM（用 STT_LLM_MODEL_NAME 評分）
AUDIO_EVALUATOR_PROVIDER=gemini_native

# 語音處理專用 API 金鑰（與文字 LLM 的金鑰分離）
AUDIO_API_KEY=your_audio_api_key_here
# 語音 API 端點（僅 openai / proxy 供應商需要）
# AUDIO_BASE_URL=https://api.openai.com/v1
# 語音評估模型名稱
AUDIO_MODEL_NAME=gemini-3.5-flash


# ====================================================================
# 13. STT（自架 Whisper / Speaches）
# ====================================================================
# Speaches 服務的 OpenAI 相容端點（含 /v1）
STT_SERVER_URL=http://127.0.0.1:8000/v1
# faster-whisper 模型 ID
STT_MODEL_NAME=Systran/faster-whisper-large-v3
# 自架服務金鑰（OpenAI SDK 要求非空即可）
STT_API_KEY=speaches
# stt_llm 模式專用的純文字評分模型（與多模態 AUDIO_MODEL_NAME 脫鉤）
STT_LLM_MODEL_NAME=gemini-2.5-flash


# ====================================================================
# 14. VOICEPEAK / Scripts
# ====================================================================
# VOICEPEAK CLI 執行檔路徑（已在 PATH 中可直接寫 voicepeak）
VOICEPEAK_EXECUTABLE_PATH=voicepeak
# 預設旁白角色（CLI 英文 ID）
VOICEPEAK_DEFAULT_NARRATOR=Japanese Male Child
# 角色設定 JSON（顯示名稱、CLI ID、情緒映射）
VOICEPEAK_CHARACTERS_CONFIG_PATH=characters.json

# Scripts 呼叫 FastAPI 的基礎 URL（遠端測試填 Cloudflare Tunnel 完整網域）
SCRIPTS_API_BASE_URL=http://127.0.0.1:8000
# SCRIPTS_API_BASE_URL=https://your-tunnel-domain.com
