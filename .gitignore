# =========================
# FluencyTides .gitignore
# =========================

# -------------------------
# Environment Variables & Secrets
# -------------------------
.env
.env.*
!.env.example
*.pem
*.key

# -------------------------
# Python / Backend
# -------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/src/lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
.env_venv/
ENV/
env.bak/
venv.bak/

# Database
*.db
*.sqlite3

# Test / Coverage
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.swn
*.swo
*.swp
.pytest_cache/
htmlcov/

# -------------------------
# Node / Frontend (React + Vite)
# -------------------------
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
.npm/

# Vite specific
.eslintcache
*.tsbuildinfo

# -------------------------
# IDE / OS / Editor
# -------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# -------------------------
# Logs & Agent
# -------------------------
*.log
.agent/
memo/
old/
/sql/

# -------------------------
# 個人卡片素材 (Personal card data)
# -------------------------
# 個人練習用的 Anki 卡片 JSON：內容因人而異、且可能含私人素材路徑，不進版控
backend/scripts/local_anki/Speaking_Trilingual_Dark/jsons/
backend/scripts/local_anki/Speaking_Coach_Dark/jsons/

# -------------------------
# claude-code LLM provider 執行產物 (Runtime artifacts)
# -------------------------
# CLI 執行用的專用空目錄、每次呼叫的 prompt/answer 審計紀錄，
# 以及挖空定位失敗紀錄等執行期日誌（logs/ 下全為執行期產物）
backend/.claude_code_workdir/
backend/logs/
